package chip8

CPU :: struct {
	memory:          [4096]u8,
	v_registers:     [16]u8,
	index_register:  u16,
	program_counter: u16,
	graphics:        [64 * 32]u32,
	delay_timer:     u8,
	sound_timer:     u8,
	keypad:          [16]u8,
	stack:           [16]u16,
	stack_ptr:       u16,
}


READ_ROM_ERROR :: enum {
	None,
	Unreadable,
}

MAX_ROM_SIZE :: 4096 - 0x200

FONT_SET :: [80]u8 {
	0xF0,
	0x90,
	0x90,
	0x90,
