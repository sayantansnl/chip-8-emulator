decoded_opcode :: struct {
	type: u16,
	x:    u16,
	y:    u16,
	n:    u16,
	nnn:  u16,
	kk:   u16,
}

FLAG_REGISTER :: 0x0F
FONTSET_START_LOCATION :: 0x50
